# Copy this file to .env and fill in your values.
# .env is gitignored -- never commit real secrets.

# --- Neo4j ---
# Local Docker/Desktop:  bolt://localhost:7687
# Aura:                  neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHATGPT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# --- Azure auth ---
# Option A: service principal (what this project uses by default)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Option B: plain API key. If this is set it takes priority and the
# service-principal values above are ignored.
AZURE_OPENAI_API_KEY=

# --- Tuning (optional) ---
KG_MAX_CHUNK_CHARS=2000
KG_CHUNK_OVERLAP=200
KG_MIN_CHUNK_CHARS=120
KG_WRITE_BATCH_SIZE=500
